# Engadir estas liñas ao .env que xa existe en /home/alberto/server/.env
# (o mesmo que usan minio e anti-bot-telegram, vía env_file: .env).

# API key de Anthropic — https://console.anthropic.com/
# (o login OAuth dunha subscrición Claude Max NON funciona nun VPS sen
# navegador, ten que ser unha API key).
ANTHROPIC_API_KEY=sk-ant-...

# Token do bot de Telegram, de @BotFather (/newbot). Ten que ser un bot NOVO
# e dedicado — non reutilizar o de anti-bot-telegram, que xa fai outra cousa
# (verificación anti-spam de grupos) e un token só pode atender un proceso.
TELEGRAM_BOT_TOKEN=...

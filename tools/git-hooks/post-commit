#!/bin/sh
# Xera automaticamente os medios (cartel PNG, vídeo e HTML autónomo) de:
#   - calquera evento novo ou modificado en src/data/eventos/proximoseventos/
#     (node tools/generate-event-media.mjs) → public/images/poster/generated/
#   - calquera nova nova ou modificada en src/content/news/ que teña un
#     bloque `video:` no frontmatter (node tools/generate-news-media.mjs)
#     → public/images/news/generated/
# e engade eses ficheiros nun commit adicional "chore(media): ...".
#
# Instalación (unha vez por clon):
#   git config core.hooksPath tools/git-hooks
#
# Protección anti-recursión: os commits que xera este mesmo hook levan o
# prefixo "chore(media):" na mensaxe — se o último commit xa o leva, saímos
# sen facer nada (se non, cada commit xerado dispararía outro post-commit).

last_msg=$(git log -1 --pretty=%s 2>/dev/null || echo "")
case "$last_msg" in
    "chore(media):"*)
        exit 0
        ;;
esac

# --- Eventos -----------------------------------------------------------
event_slugs=""
for f in $(git diff-tree --no-commit-id --name-only -r --diff-filter=ACM HEAD -- src/data/eventos/proximoseventos/ 2>/dev/null); do
    case "$f" in
        *.json) event_slugs="$event_slugs $(basename "$f" .json)" ;;
    esac
done

# --- Novas (só as que declaran `video:` no frontmatter) ------------------
news_slugs=""
for f in $(git diff-tree --no-commit-id --name-only -r --diff-filter=ACM HEAD -- src/content/news/ 2>/dev/null); do
    case "$f" in
        *.md)
            if git show "HEAD:$f" | awk 'NR==1 && $0 !~ /^---/ {exit 1} NR>1 && /^---/ {exit !found} /^video:/ {found=1} END {exit !found}'; then
                news_slugs="$news_slugs $(basename "$f" .md)"
            fi
            ;;
    esac
done

[ -z "$event_slugs" ] && [ -z "$news_slugs" ] && exit 0

added=""
if [ -n "$event_slugs" ]; then
    echo "post-commit: xerando cartel e vídeo de eventos:$event_slugs"
    if node tools/generate-event-media.mjs $event_slugs; then
        git add public/images/poster/generated/ 2>/dev/null
        added="$added eventos:$(echo "$event_slugs" | tr -s ' ' ',' | sed 's/^,//')"
    else
        echo "post-commit: xeración de media de eventos fallou — omitida." >&2
    fi
fi

if [ -n "$news_slugs" ]; then
    echo "post-commit: xerando cartel e vídeo de novas:$news_slugs"
    if node tools/generate-news-media.mjs $news_slugs; then
        git add public/images/news/generated/ 2>/dev/null
        added="$added novas:$(echo "$news_slugs" | tr -s ' ' ',' | sed 's/^,//')"
    else
        echo "post-commit: xeración de media de novas fallou — omitida." >&2
    fi
fi

if git diff --cached --quiet; then
    echo "post-commit: nada novo que commitear (media xa estaba ao día)."
    exit 0
fi

git commit -m "chore(media): xerar cartel e vídeo para$added" --quiet
echo "post-commit: commit adicional creado con cartel/vídeo xerados."

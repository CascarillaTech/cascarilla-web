---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/LayoutBasic.astro';
import '../../styles/event.css';
import evento from '../../data/eventos/proximoseventos/one-ai-day.json';

const org = await getEntry('org', 'info');
const contactEmail = org?.data.email ?? 'asociacion@cascarillatech.org';

// Data formatada a partir do startDate en formato OTE (ISO, sen fuso)
const eventDateOnly = evento.startDate.split('T')[0];
const fechaTexto = new Date(evento.startDate).toLocaleDateString('gl-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const speakerPlaceholder = "/images/speaker-placeholder.svg";
const companyPlaceholder = "/images/company-placeholder.svg";

// As charlas (type: "talk") levan na propia axenda os datos do poñente
const agenda = evento.agenda.map((item) => ({ ...item, isTalk: item.type === "talk" }));

const sponsors = evento.sponsors ?? [];
---

<Layout frontmatter={{
    title: `${evento.name} - Cascarilla Tech`,
    description: evento.description,
    ogImage: '/images/poster/generated/one-ai-day.png',
}}>

    <section class="event-section">

        <header class="event-hero">
            <img src="/images/un-dia-con-ia-robot.jpg" alt="Robot mascota de Un día con IA" class="event-hero-img" width="1024" height="647" />
            <h1>{evento.name}</h1>
            <div class="event-meta">
                <span>📅 {fechaTexto}</span>
                <span>📍 {evento.location.venue.includes('Odeene') ? (
                    <a href="https://www.odeene.es" target="_blank" rel="noopener noreferrer">{evento.location.venue}</a>
                ) : evento.location.venue}</span>
            </div>
            <p>{evento.description}</p>
            <p class="event-organizers">
                Organizado por:
                {evento.organizers.map((org) => (
                        <a href={org.url} target="_blank" rel="noopener noreferrer" class="organizer-link">
                            <img src={org.logo} alt={`Logo de ${org.name}`} class="organizer-logo" />
                            {org.name}
                        </a>
                ))}
            </p>
        </header>

        <section class="event-section-block">
            <div class="section-heading-row">
                <h2>Axenda</h2>
                <button type="button" id="agenda-toggle-btn" class="agenda-toggle-btn" aria-expanded="true" aria-controls="agenda-accordion">
                    Ocultar axenda ▲
                </button>
            </div>
            <p class="section-intro">
                Programa completo do día, de porta a porta. Toca en cada franxa para ver máis detalle;
                nas charlas ábrese directamente a súa ficha.
            </p>

            <ul class="agenda-accordion" id="agenda-accordion">
                {agenda.map((item, idx) => (
                        item.isTalk ? (
                                <li class="agenda-acc-item agenda-acc-talk" data-idx={idx}>
                                    <button type="button" class="agenda-acc-trigger talk-open-btn" data-talk-idx={idx}>
                                        <span class="agenda-time">{item.time}</span>
                                        <img src={item.photo ?? speakerPlaceholder} alt="" width="44" height="44" class="agenda-speaker-avatar" />
                                        <span class="agenda-titlewrap">
                                            <strong>{item.name}</strong>
                                            <span class="agenda-speaker-inline">
                                                Poñente: {item.speaker}
                                            </span>
                                        </span>
                                        <span class="agenda-acc-icon" aria-hidden="true">→</span>
                                    </button>
                                </li>
                        ) : (
                                <li class="agenda-acc-item" data-idx={idx}>
                                    <button type="button" class="agenda-acc-trigger" aria-expanded="false">
                                        <span class="agenda-time">{item.time}</span>
                                        <span class="agenda-titlewrap">
                                            <strong>{item.name}</strong>
                                        </span>
                                        <span class="agenda-acc-icon" aria-hidden="true">+</span>
                                    </button>
                                    <div class="agenda-acc-panel">
                                        <p>{item.description}</p>
                                    </div>
                                </li>
                        )
                ))}
            </ul>
        </section>

        <section class="event-section-block">
            <h2>As charlas</h2>
            <p class="section-intro">Poñentes en confirmación — en canto os pechemos, actualizamos esta sección.</p>

            <div class="talks-grid">
                {agenda.filter((i) => i.isTalk).map((talk) => {
                    const idx = agenda.indexOf(talk);
                    return (
                            <button type="button" class="talk-card talk-open-btn" data-talk-idx={idx}>
                                <img src={talk.photo ?? speakerPlaceholder} alt={talk.photo ? `Foto de ${talk.speaker}` : 'Foto de exemplo do/a poñente'} />
                                <p class="talk-time">{talk.time}</p>
                                <h3>{talk.name}</h3>
                                <p class="talk-speaker">Poñente: {talk.speaker}</p>
                            </button>
                    );
                })}
            </div>
        </section>

        <section class="event-section-block">
            <h2>Empresas colaboradoras</h2>
            <p class="section-intro">
                Grazas a <strong>{sponsors.map((s) => s.name).join(' e ')}</strong> por participar no evento. Se queres formar parte deste evento,
                <a href={`mailto:${contactEmail}`}>ponte en contacto connosco</a> e vemos a forma de colaborar.
            </p>

            <div class="sponsors-grid">
                {sponsors.map((sponsor) => (
                        <a class="sponsor-card" href={sponsor.url} target="_blank" rel="noopener noreferrer">
                            <img src={sponsor.img ?? companyPlaceholder} alt={`Logo de ${sponsor.name}`} />
                        </a>
                ))}
            </div>
        </section>

        <section class="event-section-block">
            <h2>Entradas</h2>
            <div class="tickets-box">
                {evento.eventbriteUrl ? (
                    <>
                        <p class="ticket-price">Desde {evento.price.amount}{evento.price.currency}</p>
                        <p class="ticket-price-note">{evento.price.note}</p>
                        <a class="ticket-buy-btn" href={evento.eventbriteUrl} target="_blank" rel="noopener noreferrer">Merca a túa entrada</a>
                        <p class="ticket-member-note">
                            Os socios e socias de Cascarilla Tech teñen desconto.
                            <a href="/membership">Faite socio/a</a> e
                            <a href={`mailto:${contactEmail}`}>solicita o teu</a>.
                        </p>
                    </>
                ) : (
                    <>
                        <p class="ticket-price">Entradas non dispoñibles de momento</p>
                        <p class="ticket-price-note">{evento.price.note}</p>
                    </>
                )}
            </div>
        </section>

    </section>

    <dialog id="talk-modal" class="talk-modal">
        <button type="button" class="talk-modal-close" aria-label="Pechar">✕</button>
        <img id="talk-modal-img" src={speakerPlaceholder} data-placeholder={speakerPlaceholder} alt="Foto de exemplo do/a poñente" />
        <p class="talk-modal-time" id="talk-modal-time"></p>
        <h3 id="talk-modal-title"></h3>
        <p class="talk-modal-speaker" id="talk-modal-speaker"></p>
        <p id="talk-modal-bio" class="talk-modal-bio" hidden></p>
        <p id="talk-modal-links" class="talk-modal-links" hidden></p>
        <h4 id="talk-modal-title-2" class="talk-modal-title-2"></h4>
        <p id="talk-modal-desc"></p>
    </dialog>

</Layout>

<script define:vars={{ agenda }}>
    // --- Acordeón da axenda (só para as franxas que non son charla) ---
    document.querySelectorAll('.agenda-acc-trigger:not(.talk-open-btn)').forEach((btn) => {
        btn.addEventListener('click', () => {
            const item = btn.closest('.agenda-acc-item');
            const isOpen = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!isOpen));
            item.classList.toggle('open', !isOpen);
        });
    });

    // --- Colapsar/amosar a axenda enteira ---
    const agendaToggleBtn = document.getElementById('agenda-toggle-btn');
    const agendaList = document.getElementById('agenda-accordion');

    agendaToggleBtn?.addEventListener('click', () => {
        const isHidden = agendaList.classList.toggle('agenda-hidden');
        agendaToggleBtn.setAttribute('aria-expanded', String(!isHidden));
        agendaToggleBtn.textContent = isHidden ? 'Amosar axenda ▼' : 'Ocultar axenda ▲';
    });

    // --- Modal de charla (agenda e sección de charlas destacadas comparten botón) ---
    const dialog = document.getElementById('talk-modal');

    document.querySelectorAll('.talk-open-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
            const idx = Number(btn.dataset.talkIdx);
            const talk = agenda[idx];
            document.getElementById('talk-modal-title').textContent = talk.name;
            document.getElementById('talk-modal-title-2').textContent = talk.name;
            document.getElementById('talk-modal-time').textContent = talk.time;
            document.getElementById('talk-modal-speaker').textContent = 'Poñente: ' + (talk.speaker || 'TBA');
            document.getElementById('talk-modal-desc').textContent = talk.description || 'Descrición pendente de confirmar.';
            const img = document.getElementById('talk-modal-img');
            img.src = talk.photo || img.dataset.placeholder;
            img.alt = talk.photo ? 'Foto de ' + talk.speaker : 'Foto de exemplo do/a poñente';

            const bio = document.getElementById('talk-modal-bio');
            bio.textContent = talk.bio || '';
            bio.hidden = !talk.bio;

            const links = document.getElementById('talk-modal-links');
            links.replaceChildren();
            (talk.links || []).forEach((l, i) => {
                if (i > 0) links.append(' · ');
                const a = document.createElement('a');
                a.href = l.url;
                a.textContent = l.label;
                a.target = '_blank';
                a.rel = 'noopener noreferrer';
                links.append(a);
            });
            links.hidden = !(talk.links && talk.links.length);
            dialog.showModal();
        });
    });

    dialog?.querySelector('.talk-modal-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
    });

    // --- Estado da axenda segundo a hora (pasada / activa) ---
    // Hora de Madrid como "AAAA-MM-DDTHH:MM", comparable como texto cos
    // startDate/endDate da axenda. Para probar: ?now=2026-11-21T11:30
    function madridNow() {
        const forced = new URLSearchParams(location.search).get('now');
        if (forced) return forced.slice(0, 16);
        const p = Object.fromEntries(
            new Intl.DateTimeFormat('en-CA', {
                timeZone: 'Europe/Madrid', hourCycle: 'h23',
                year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
            }).formatToParts(new Date()).map((x) => [x.type, x.value])
        );
        return `${p.year}-${p.month}-${p.day}T${p.hour}:${p.minute}`;
    }

    function updateAgendaState() {
        const now = madridNow();
        document.querySelectorAll('.agenda-acc-item').forEach((el) => {
            const item = agenda[Number(el.dataset.idx)];
            const start = item.startDate.slice(0, 16);
            const end = item.endDate.slice(0, 16);
            const isPast = end <= now;
            const isCurrent = start <= now && now < end;
            el.classList.toggle('agenda-past', isPast);
            el.classList.toggle('agenda-current', isCurrent);
            if (isCurrent) {
                el.setAttribute('aria-current', 'true');
            } else {
                el.removeAttribute('aria-current');
            }
        });
    }

    updateAgendaState();
    setInterval(updateAgendaState, 60000);
</script>

---
// Páxina "cartel" dun evento: SEN o Layout do sitio (sen header/nav/footer)
// a propósito — isto ten que ser exactamente o canvas de 1200x630 do
// deseño promocional, nada máis. É a fonte única do deseño para xerar
// tanto a imaxe coma o vídeo do evento (ver poster.css e
// ~/.claude/skills/publish-event/references/poster-design.md).
import '../../styles/poster.css';

const ORGANIZER_LOGOS: Record<string, string> = {
    "Coruña JUG": "corunajug-logo.png",
    "CoruñaWTF": "corunawtf-logo.png",
    "Coruña WTF": "corunawtf-logo.png",
};

const MESES_GL = [
    "xaneiro", "febreiro", "marzo", "abril", "maio", "xuño",
    "xullo", "agosto", "setembro", "outubro", "novembro", "decembro",
];

const DEFAULT_SPEAKER_SLOT = {
    name: "Coruña JUG",
    role: "Comunidade",
    image: "/images/poster/talks/default-corunajug-cascarilla.png",
    shape: "square",
};

export async function getStaticPaths() {
    const proximos = import.meta.glob('../../data/eventos/proximoseventos/*.json', { eager: true });
    const pasados = import.meta.glob('../../data/eventos/eventospasados/*.json', { eager: true });
    const modules = { ...proximos, ...pasados };

    return Object.entries(modules).map(([path, mod]) => {
        const slug = path.split('/').pop()!.replace('.json', '');
        return { params: { slug }, props: { event: (mod as any).default } };
    });
}

const { event } = Astro.props;

// --- Organizadores: todos menos Cascarilla Tech van á esquerda, en orde.
// Cascarilla Tech vai sempre fixa arriba-dereita (ver poster.css). ---
const organizersLeft = (event.organizers || [])
    .filter((o: any) => o.name !== "Cascarilla Tech")
    .map((o: any) => ORGANIZER_LOGOS[o.name] || o.name);

// --- Data/hora/lugar (formato galego, igual que event_to_poster_args) ---
const dt = new Date(event.startDate);
const dateStr = `${dt.getDate()} de ${MESES_GL[dt.getMonth()]} de ${dt.getFullYear()}`;
const timeStr = `${String(dt.getHours()).padStart(2, '0')}:${String(dt.getMinutes()).padStart(2, '0')}`;
const footerDate = `${dateStr}  ·  ${timeStr}`;
const footerVenue = event.location?.venue || null;

// --- Sponsors e speakers ---
const sponsors = (event.sponsors || []).map((s: any) => s.img.split('/').pop());
const speakers = (event.speakers && event.speakers.length) ? event.speakers : [DEFAULT_SPEAKER_SLOT];

function resolveSpeakerImage(sp: any) {
    if (!sp.image) return "/images/speaker-placeholder.svg";
    if (sp.image === DEFAULT_SPEAKER_SLOT.image) return sp.image;
    return `/images/poster/speakers/${sp.image.split('/').pop()}`;
}

// --- Xeometría do bloque de ponentes (mesmas fórmulas que render_poster) ---
const n = speakers.length;
const circleD = n === 1 ? 140 : 110;
const speakerGap = n === 1 ? 50 : 70;
const rightMargin = n === 1 ? 110 : 60;
const blockW = n * circleD + (n - 1) * speakerGap;
const startCx = 1200 - rightMargin - blockW + circleD / 2;
const speakersLeftEdge = n ? startCx - circleD / 2 : 1200 - 60;

// O marco hexagonal do slot por defecto ("square") é un pouco máis grande
// có ancho real da foto (para que non tape o logo cos recortes das puntas),
// pero a foto de dentro NON se agranda — queda fixa a circleD, centrada no
// marco. Marxe negativa para que o marco maior non desprace o resto do
// layout (gaps, nome do speaker seguinte, etc.).
const HEX_SCALE = 1.18;
const hexSize = circleD * HEX_SCALE;
const hexMargin = -(hexSize - circleD) / 2;

// --- Ancho dispoñible para o título antes de chocar cos ponentes ---
const titleLeft = 90;
const titleGapBeforeSpeakers = 40;
const titleMaxW = speakersLeftEdge - titleGapBeforeSpeakers - titleLeft;

// --- Fila de sponsors, enriba da banda escura ---
const bandCy = 630 - 80 - 46;

// --- Efecto máquina de escribir (título, data, lugar): cada letra é o
// seu propio span cun transition-delay propio, así o "typing" en si o fai
// o CSS (ver poster.css), sen setInterval en JS. Array.from en vez de
// split('') para non partir mal os caracteres compostos/acentos. ---
const TYPE_CHAR_DELAY_MS = 33;
const titleChars = Array.from(event.name as string);
const footerDateChars = Array.from(footerDate);
const footerVenueChars = footerVenue ? Array.from(footerVenue) : [];
---
<!DOCTYPE html>
<html lang="gl">
<head>
    <meta charset="UTF-8" />
    <title>{event.name} — Cascarilla Tech</title>
</head>
<body>
<div class="poster" id="poster">

    <div class="poster-organizers">
        {organizersLeft.map((fname: string) => (
            <img src={`/images/poster/organizers/${fname}`} alt="" />
        ))}
    </div>

    <div class="poster-cascarilla">
        <img src="/images/poster/organizers/cascarillatech-logo.png" alt="Cascarilla Tech" />
    </div>

    <div class="poster-title-block" style={`width:${titleMaxW}px`}>
        <h1 class="poster-title" id="poster-title">
            {titleChars.map((ch: string, i: number) => (
                <span class="tw-char" style={`transition-delay:${i * TYPE_CHAR_DELAY_MS}ms`}>{ch}</span>
            ))}
        </h1>
    </div>
    <div class="poster-title-underline-wrap" id="poster-underline-wrap">
        <div class="poster-title-underline" id="poster-underline"></div>
    </div>

    <div
        class="poster-speakers"
        id="poster-speakers"
        style={`left:${speakersLeftEdge}px; width:${blockW}px; gap:${speakerGap}px;`}
    >
        {speakers.map((sp: any, spIdx: number) => (
            <div class={`poster-speaker poster-speaker--${sp.shape === 'square' ? 'square' : 'circle'} ${circleD < 130 ? 'poster-speaker--small' : ''}`}>
                <div
                    class="poster-speaker-frame"
                    style={sp.shape === 'square'
                        ? `width:${hexSize}px;height:${hexSize}px;margin:${hexMargin}px;`
                        : `width:${circleD}px;height:${circleD}px;`}
                >
                    {sp.shape === 'square' ? (
                        <div class="poster-speaker-frame-inner">
                            <img
                                class="poster-speaker-photo"
                                style={`width:${circleD}px;height:${circleD}px;`}
                                src={resolveSpeakerImage(sp)}
                                alt={sp.name}
                            />
                        </div>
                    ) : (
                        <img
                            class="poster-speaker-photo"
                            style={`width:${circleD}px;height:${circleD}px;`}
                            src={resolveSpeakerImage(sp)}
                            alt={sp.name}
                        />
                    )}
                </div>
                <p class="poster-speaker-name" id={`poster-speaker-name-${spIdx}`}>
                    {Array.from(sp.name as string).map((ch: string, i: number) => (
                        <span class="tw-char" style={`transition-delay:${i * TYPE_CHAR_DELAY_MS}ms`}>{ch}</span>
                    ))}
                </p>
                <p class="poster-speaker-role" id={`poster-speaker-role-${spIdx}`}>
                    {Array.from(sp.role as string).map((ch: string, i: number) => (
                        <span class="tw-char" style={`transition-delay:${i * TYPE_CHAR_DELAY_MS}ms`}>{ch}</span>
                    ))}
                </p>
            </div>
        ))}
    </div>

    {sponsors.length > 0 && (
        <div class="poster-sponsors" id="poster-sponsors" style={`top:${bandCy}px`}>
            <div class="poster-sponsors-label">
                <span class="poster-sponsors-text" id="poster-sponsors-text">Powered by</span>
                <span class="poster-sponsors-circuit-wrap" id="poster-sponsors-circuit-wrap">
                    <svg class="poster-sponsors-circuit" id="poster-sponsors-circuit" width="90" height="14" viewBox="0 0 90 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <line x1="0" y1="7" x2="38" y2="7" stroke="currentColor" stroke-width="2" />
                        <circle cx="0" cy="7" r="2.5" fill="currentColor" />
                        <line x1="40" y1="1" x2="40" y2="13" stroke="currentColor" stroke-width="2" />
                        <line x1="48" y1="3" x2="48" y2="11" stroke="currentColor" stroke-width="4" />
                        <line x1="52" y1="7" x2="90" y2="7" stroke="currentColor" stroke-width="2" />
                        <circle cx="90" cy="7" r="2.5" fill="currentColor" />
                    </svg>
                </span>
            </div>
            <div class="poster-sponsors-logos">
                {sponsors.map((fname: string, i: number) => (
                    <img src={`/images/poster/sponsors/${fname}`} alt="" style={`transition-delay:${i * 120}ms`} />
                ))}
            </div>
        </div>
    )}

    <div class="poster-footer">
        <svg class="poster-footer-icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="1" y="5" width="20" height="16" rx="2.5" stroke="currentColor" stroke-width="2" />
            <line x1="1" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2" />
            <line x1="6.7" y1="1" x2="6.7" y2="7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            <line x1="15.3" y1="1" x2="15.3" y2="7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        </svg>
        <span id="poster-footer-date">
            {footerDateChars.map((ch: string, i: number) => (
                <span class="tw-char" style={`transition-delay:${i * TYPE_CHAR_DELAY_MS}ms`}>{ch}</span>
            ))}
        </span>
        {footerVenue && (
            <>
                <svg class="poster-footer-icon poster-footer-venue" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.5 9 L11 4 L17.5 9 L14 9 L14 21 L8 21 L8 9 Z" fill="currentColor" opacity="0" />
                    <path d="M4 9.5 C4 5.4 7.1 2 11 2 C14.9 2 18 5.4 18 9.5 C18 14.5 11 21 11 21 C11 21 4 14.5 4 9.5 Z" fill="currentColor" />
                    <circle cx="11" cy="9.3" r="3.4" fill="#382117" />
                </svg>
                <span class="poster-footer-venue-text" id="poster-footer-venue">
                    {footerVenueChars.map((ch: string, i: number) => (
                        <span class="tw-char" style={`transition-delay:${i * TYPE_CHAR_DELAY_MS}ms`}>{ch}</span>
                    ))}
                </span>
            </>
        )}
    </div>

</div>

<script>
    const HL_MARGIN = 18;
    const HL_THICKNESS = 12;
    const HL_GAP = 34;

    // Posicións calculadas trala primeira medida do título — o texto
    // completo xa está no DOM dende o principio (só oculto letra a letra
    // vía opacity), así que o wrap en liñas xa é definitivo dende o
    // arranque e isto pode executarse antes de que remate o "escribido".
    let pending = null;

    function layoutPoster() {
        const poster = document.getElementById('poster');
        const title = document.getElementById('poster-title');
        const underline = document.getElementById('poster-underline');
        const underlineWrap = document.getElementById('poster-underline-wrap');
        const speakers = document.getElementById('poster-speakers');
        const sponsorsCircuit = document.getElementById('poster-sponsors-circuit');
        const sponsorsText = document.getElementById('poster-sponsors-text');
        if (!poster || !title || !underline) return;

        const posterRect = poster.getBoundingClientRect();

        // Mide directamente cada letra (.tw-char) e agrúpaas por liña — non
        // se pode usar un Range sobre o título enteiro porque agora ten un
        // <span> por letra (+ o cursor): Range.getClientRects() devolvería
        // un rect por letra en vez dun por liña, e o "último rect" acabaría
        // sendo o cursor (4px) en vez da liña completa.
        const chars = Array.from(title.querySelectorAll('.tw-char'));
        const lines = [];
        for (const el of chars) {
            const r = el.getBoundingClientRect();
            const top = Math.round(r.top);
            let line = lines.find((l) => Math.abs(l.top - top) < 4);
            if (!line) {
                line = { top, left: r.left, right: r.right, bottom: r.bottom };
                lines.push(line);
            } else {
                line.left = Math.min(line.left, r.left);
                line.right = Math.max(line.right, r.right);
                line.bottom = Math.max(line.bottom, r.bottom);
            }
        }
        lines.sort((a, b) => a.top - b.top);
        const rects = lines.map((l) => ({ left: l.left, right: l.right, width: l.right - l.left, top: l.top, bottom: l.bottom }));

        if (rects.length) {
            const leftEdge = rects[0].left - posterRect.left;
            const maxLineW = Math.max(...rects.map((r) => r.width));
            const lastRect = rects[rects.length - 1];

            const hlWidth = Math.max(lastRect.width - 2 * HL_MARGIN, 20);
            const hlX1 = leftEdge + maxLineW - HL_MARGIN;
            const hlX0 = hlX1 - hlWidth;
            const hlY = (lastRect.bottom - posterRect.top) + HL_GAP;

            // O wrapper leva a posición/ancho final (fixo) e faille de
            // "ventá" con overflow:hidden; o trazo de dentro xa nace co
            // seu ancho definitivo (hlWidth) para que as puntas irregulares
            // debuxadas a man non se deformen — o que anima é canto do
            // wrapper se ve, non o trazo en si (ver revealDecorations).
            underlineWrap.style.left = `${hlX0}px`;
            underlineWrap.style.top = `${hlY - HL_THICKNESS / 2}px`;
            underlineWrap.style.height = `${HL_THICKNESS}px`;
            underlineWrap.style.width = '0px';
            underline.style.width = `${hlWidth}px`;
            underline.style.height = `${HL_THICKNESS}px`;

            if (speakers) {
                const titleTop = rects[0].top - posterRect.top;
                const titleBottom = lastRect.bottom - posterRect.top;
                const titleMid = (titleTop + titleBottom) / 2;
                // Centra o propio marco/foto (non o bloque enteiro nome+cargo
                // incluído) na altura das letras do título — se non, o peso
                // do nome+cargo por debaixo desprazaba o hexágono cara arriba.
                const frame = speakers.querySelector('.poster-speaker-frame');
                const frameH = frame ? frame.getBoundingClientRect().height : speakers.getBoundingClientRect().height;
                const SPEAKERS_NUDGE_DOWN = 10; // ~1.5% do alto do cartel (630px), axuste fino a ollo
                speakers.style.top = `${titleMid - frameH / 2 + SPEAKERS_NUDGE_DOWN}px`;
            }
        }

        let circuitW = 0;
        if (sponsorsCircuit && sponsorsText) {
            circuitW = sponsorsText.getBoundingClientRect().width;
            sponsorsCircuit.setAttribute('width', String(circuitW));
        }

        pending = { underlineWrap, speakers, hlWidth: underline.style.width, circuitW };
    }

    const UNDERLINE_TRANSITION_MS = 400; // igual có "width 0.38s" de poster.css + marxe

    function wait(ms) {
        return new Promise((resolve) => window.setTimeout(resolve, ms));
    }

    // Escribe as letras dun contedor (título ou texto do footer) e devolve
    // unha promesa que remata cando xa se viron todas — así toda a
    // secuencia (título → subrayado → data → lugar) se encadea con
    // async/await en vez de aniñar setTimeouts.
    function typeElement(el) {
        if (!el) return Promise.resolve();
        const chars = el.querySelectorAll('.tw-char');
        if (!chars.length) return Promise.resolve();

        el.classList.add('tw-typing');
        void el.offsetWidth; // forza reflow para que a transición se dispare
        el.classList.add('tw-start');

        const last = chars[chars.length - 1];
        const lastDelay = parseFloat(last.style.transitionDelay) || 0;
        const totalMs = lastDelay + 130;

        return wait(totalMs).then(() => {
            el.classList.remove('tw-typing');
            el.classList.add('tw-done');
        });
    }

    // Amosa o subrayado só cando remata de "escribirse" o título — se non,
    // aparecía debaixo dun título aínda a medio escribir. A foto/marco do
    // ponente xa é visible dende o principio (non pasa por aquí); o subrayado
    // "debúxase" el mesmo: o wrapper arranca en 0 de ancho e transiciona ata
    // o ancho real, revelando o trazo de esquerda a dereita coma se o
    // trazaran a man. Devolve unha promesa que remata coa transición.
    function revealUnderline() {
        if (!pending) return Promise.resolve();
        pending.underlineWrap.classList.add('tw-visible');
        void pending.underlineWrap.offsetWidth;
        pending.underlineWrap.style.width = pending.hlWidth;
        return wait(UNDERLINE_TRANSITION_MS);
    }

    // "Powered by" + circuíto + logos — todo isto arrinca á vez cá data
    // (non se agarda, ver boot()). O texto e os logos son transicións CSS
    // vía a clase .sp-start; o circuíto usa o mesmo truco de
    // wrapper+overflow:hidden có ancho animado có subrayado.
    function revealSponsors() {
        const el = document.getElementById('poster-sponsors');
        const circuitWrap = document.getElementById('poster-sponsors-circuit-wrap');
        if (!el) return;
        el.classList.add('sp-start');
        if (circuitWrap && pending) {
            void circuitWrap.offsetWidth;
            circuitWrap.style.width = `${pending.circuitW}px`;
        }
    }

    async function boot() {
        layoutPoster();
        await typeElement(document.getElementById('poster-title'));
        await revealUnderline();
        for (const sp of Array.from(document.querySelectorAll('.poster-speaker'))) {
            sp.classList.add('sp-start'); // fade-in da foto á vez có nome, non se agarda
            await typeElement(sp.querySelector('.poster-speaker-name'));
            await typeElement(sp.querySelector('.poster-speaker-role'));
        }
        revealSponsors(); // á vez cá data, non se agarda
        await typeElement(document.getElementById('poster-footer-date'));
        await typeElement(document.getElementById('poster-footer-venue'));
    }

    if ((document as any).fonts && (document as any).fonts.ready) {
        (document as any).fonts.ready.then(boot);
    } else {
        window.addEventListener('load', boot);
    }
</script>
</body>
</html>

---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/LayoutLanding.astro';

const entry = await getEntry('pages', 'index');

if (!entry) {
	return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<Layout frontmatter={entry.data}>

	<a href="/evento/un-dia-con-ia" class="event-banner">
		<span class="event-banner-badge">🚀 Próximo evento</span>
		<span class="event-banner-title">Un día con IA</span>
		<span class="event-banner-meta">21 de setembro de 2026 · Cidade das TIC, A Coruña</span>
		<span class="event-banner-cta">Ver máis &rarr;</span>
	</a>

	<Content />
	<section slot="footer-extra">
		<p>Todos os beneficios que se obteñan por calquera concepto destínanse exclusivamente ao cumprimento dos fins estatutarios, sen fins lucrativos.</p>
	</section>

</Layout>
---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/LayoutLanding.astro';

const entry = await getEntry('pages', 'index');

if (!entry) {
	return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<Layout frontmatter={entry.data}>

	<a href="/novas/un-dia-con-ia" class="event-banner">
		<span class="event-banner-badge">🚀 Novidade</span>
		<span class="event-banner-title">Charla con IA</span>
		<span class="event-banner-meta">21 de novembro de 2026 · Cidade das TIC, A Coruña</span>
		<span class="event-banner-cta">Ler a nova &rarr;</span>
	</a>

	<Content />

</Layout>
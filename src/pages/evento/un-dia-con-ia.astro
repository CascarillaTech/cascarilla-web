---
import Layout from '../../layouts/LayoutBasic.astro';
import '../../styles/event.css';
import evento from '../../data/eventos/un-dia-con-ia.json';

const speakerPlaceholder = "/images/speaker-placeholder.svg";
const companyPlaceholder = "/images/company-placeholder.svg";

// Cada charla vive no seu propio ficheiro en data/eventos/undiaconia/*.json
const charlasModules = import.meta.glob('../../data/eventos/undiaconia/*.json', { eager: true });
const charlasById = Object.fromEntries(
    Object.values(charlasModules).map((mod) => [mod.default.id, mod.default])
);

// Fusiona a axenda: as entradas con `talkId` collen os datos completos da súa charla
const axenda = evento.axenda.map((item) => {
    if (item.talkId) {
        const charla = charlasById[item.talkId];
        return { ...charla, isTalk: true };
    }
    return item;
});

const sponsors = [1, 2, 3];
---

<Layout frontmatter={{ title: `${evento.nombre} · Dossier — Cascarilla Tech`, noindex: true }}>

    <section class="event-section">

        <header class="event-hero">
            <span class="event-badge">Dossier para colaboradoras</span>
            <h1>{evento.nombre}</h1>
            <div class="event-meta">
                <span>📅 {evento.fechaTexto}</span>
                <span>📍 {evento.lugar.includes('Odeene') ? (
                    <a href="https://www.odeene.es" target="_blank" rel="noopener noreferrer">{evento.lugar}</a>
                ) : evento.lugar}</span>
            </div>
            <p>
                Unha xornada tecnolóxica pensada para conectar comunidade, coñecemento e empresas de A Coruña.
            </p>
            <p class="event-organizers">
                Organizado por:
                {evento.organizadores.map((org) => (
                        <a href={org.url} target="_blank" rel="noopener noreferrer" class="organizer-link">
                            <img src={org.logo} alt={`Logo de ${org.nome}`} class="organizer-logo" />
                            {org.nome}
                        </a>
                ))}
            </p>
        </header>

        <section class="event-section-block">
            <div class="section-heading-row">
                <h2>Axenda</h2>
                <button type="button" id="agenda-toggle-btn" class="agenda-toggle-btn" aria-expanded="true" aria-controls="agenda-accordion">
                    Ocultar axenda ▲
                </button>
            </div>
            <p class="section-intro">
                Programa completo do día, de porta a porta. Toca en cada franxa para ver máis detalle;
                nas charlas ábrese directamente a súa ficha.
            </p>

            <ul class="agenda-accordion" id="agenda-accordion">
                {axenda.map((item, idx) => (
                        item.isTalk ? (
                                <li class="agenda-acc-item agenda-acc-talk" data-idx={idx}>
                                    <button type="button" class="agenda-acc-trigger talk-open-btn" data-talk-idx={idx}>
                                        <span class="agenda-time">{item.time}</span>
                                        <span class="agenda-titlewrap">
                                            <strong>{item.title}</strong>
                                            <span class="agenda-speaker-inline">
                                                <img src={speakerPlaceholder} alt="" width="18" height="18" class="agenda-speaker-avatar" />
                                                Poñente: {item.speaker}
                                            </span>
                                        </span>
                                        <span class="agenda-acc-icon" aria-hidden="true">→</span>
                                    </button>
                                </li>
                        ) : (
                                <li class="agenda-acc-item" data-idx={idx}>
                                    <button type="button" class="agenda-acc-trigger" aria-expanded="false">
                                        <span class="agenda-time">{item.time}</span>
                                        <span class="agenda-titlewrap">
                                            <strong>{item.title}</strong>
                                        </span>
                                        <span class="agenda-acc-icon" aria-hidden="true">+</span>
                                    </button>
                                    <div class="agenda-acc-panel">
                                        <p>{item.title}, ás {item.time}.</p>
                                    </div>
                                </li>
                        )
                ))}
            </ul>
        </section>

        <section class="event-section-block">
            <h2>As charlas</h2>
            <p class="section-intro">Poñentes en confirmación — en canto os pechemos, actualizamos esta sección.</p>

            <div class="talks-grid">
                {axenda.filter((i) => i.isTalk).map((talk) => {
                    const idx = axenda.indexOf(talk);
                    return (
                            <button type="button" class="talk-card talk-open-btn" data-talk-idx={idx}>
                                <img src={speakerPlaceholder} alt="Foto de exemplo do/a poñente" />
                                <p class="talk-time">{talk.time}</p>
                                <h3>{talk.title}</h3>
                                <p class="talk-speaker">Poñente: {talk.speaker}</p>
                            </button>
                    );
                })}
            </div>
        </section>

        <section class="event-section-block">
            <h2>Empresas colaboradoras</h2>
            <p class="section-intro">
                Así se verá o espazo reservado para as empresas que colaboren co evento
                (exemplo ilustrativo, aínda sen colaboradoras confirmadas).
            </p>

            <div class="sponsors-grid">
                {sponsors.map(() => (
                        <div class="sponsor-card">
                            <img src={companyPlaceholder} alt="Logo de exemplo dunha empresa colaboradora" />
                        </div>
                ))}
            </div>
        </section>

        <section class="event-section-block">
            <h2>Entradas</h2>
            <div class="tickets-box">
                <p class="ticket-price">{evento.precio}</p>
                <p class="ticket-price-note">{evento.notaPrecio}</p>
                <a href="/evento/un-dia-con-ia" class="contact-btn">Mercar entradas</a>
            </div>
        </section>

    </section>

    <dialog id="talk-modal" class="talk-modal">
        <button type="button" class="talk-modal-close" aria-label="Pechar">✕</button>
        <img id="talk-modal-img" src={speakerPlaceholder} alt="Foto de exemplo do/a poñente" />
        <p class="talk-modal-time" id="talk-modal-time"></p>
        <h3 id="talk-modal-title"></h3>
        <p class="talk-modal-speaker" id="talk-modal-speaker"></p>
        <p id="talk-modal-desc"></p>
    </dialog>

</Layout>

<script define:vars={{ axenda, eventDateISO: evento.fecha }}>
    // --- Acordeón da axenda (só para as franxas que non son charla) ---
    document.querySelectorAll('.agenda-acc-trigger:not(.talk-open-btn)').forEach((btn) => {
        btn.addEventListener('click', () => {
            const item = btn.closest('.agenda-acc-item');
            const isOpen = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!isOpen));
            item.classList.toggle('open', !isOpen);
        });
    });

    // --- Colapsar/amosar a axenda enteira ---
    const agendaToggleBtn = document.getElementById('agenda-toggle-btn');
    const agendaList = document.getElementById('agenda-accordion');

    agendaToggleBtn?.addEventListener('click', () => {
        const isHidden = agendaList.classList.toggle('agenda-hidden');
        agendaToggleBtn.setAttribute('aria-expanded', String(!isHidden));
        agendaToggleBtn.textContent = isHidden ? 'Amosar axenda ▼' : 'Ocultar axenda ▲';
    });

    // --- Modal de charla (agenda e sección de charlas destacadas comparten botón) ---
    const dialog = document.getElementById('talk-modal');

    document.querySelectorAll('.talk-open-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
            const idx = Number(btn.dataset.talkIdx);
            const talk = axenda[idx];
            document.getElementById('talk-modal-title').textContent = talk.title;
            document.getElementById('talk-modal-time').textContent = talk.time;
            document.getElementById('talk-modal-speaker').textContent = 'Poñente: ' + (talk.speaker || 'TBA');
            document.getElementById('talk-modal-desc').textContent = talk.description || 'Descrición pendente de confirmar.';
            dialog.showModal();
        });
    });

    dialog?.querySelector('.talk-modal-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
    });

    // --- Slot actual e seguinte, só o día do evento ---
    function parseMinutes(t) {
        const [h, m] = t.split(':').map(Number);
        return h * 60 + m;
    }

    const today = new Date();
    const eventDate = new Date(`${eventDateISO}T00:00:00`);
    const isEventDay = today.toDateString() === eventDate.toDateString();

    if (isEventDay) {
        const nowMinutes = today.getHours() * 60 + today.getMinutes();
        const times = axenda.map((a) => parseMinutes(a.time));

        let currentIdx = -1;
        for (let i = 0; i < times.length; i++) {
            if (times[i] <= nowMinutes) currentIdx = i;
        }

        document.querySelectorAll('.agenda-acc-item').forEach((el, i) => {
            if (i === currentIdx) el.classList.add('agenda-current');
            if (i === currentIdx + 1) el.classList.add('agenda-next');
            if (i === currentIdx || i === currentIdx + 1) {
                el.classList.add('open');
                const panelTrigger = el.querySelector('.agenda-acc-trigger:not(.talk-open-btn)');
                panelTrigger?.setAttribute('aria-expanded', 'true');
            }
        });
    }
</script>

---
// Cartel/vídeo dunha nova. Dúas variantes: 'land' (LinkedIn, 1920x1080 en
// render) e 'ig' (Instagram, 1080x1920). A fonte única do deseño para as
// imaxes/vídeos das novas — ver src/lib/newsCard.ts e news-card.css.
//
// Unha nova pode ter varias "pantallas" (video.escenas): o logo/foto, a
// marca de Cascarilla Tech e a etiqueta quedan fixos e só cambia o texto.
import '../styles/news-card.css';
import { deriveNewsCardData, computeNewsRenderDuration } from '../lib/newsCard';
import { getAllEventModules } from '../lib/eventPoster';

interface Props { entry: any; format: 'land' | 'ig'; }
const { entry, format } = Astro.props;

const card = deriveNewsCardData(entry);
const renderDuration = computeNewsRenderDuration(card);
const chars = (s: string) => Array.from(s);
const compId = `news-${format}`;
const dataW = format === 'land' ? 1920 : 1080;
const dataH = format === 'land' ? 1080 : 1920;
// Só nas novas de poñente: fila "Powered by" cos logos das empresas
// colaboradoras do evento (mesmos ficheiros ca nos carteis de evento).
const sponsors: string[] = card.tipo === 'ponente'
    ? ((Object.values(getAllEventModules()) as any[])
        .map((m) => m.default ?? m)
        .find((ev) => ev?.name === card.evento)?.sponsors ?? [])
        .map((sp: any) => String(sp.img).split('/').pop() as string)
    : [];
const heroClass = {
    colaboradora: 'nc-hero--card',
    ponente: 'nc-hero--hex',
    evento: 'nc-hero--pic',
    xeral: 'nc-hero--pic nc-hero--icon',
}[card.tipo];
---
<!DOCTYPE html>
<html lang="gl">
<head>
    <meta charset="UTF-8" />
    <title>{card.titular} — Cascarilla Tech (nova)</title>
</head>
<body>
<div
    class={`nc nc--${format}${card.pe ? '' : ' nc--nofooter'}${sponsors.length ? ' nc--sponsors' : ''}`}
    id="poster"
    data-composition-id={compId}
    data-width={dataW}
    data-height={dataH}
    data-duration={renderDuration}
>
    {card.evento && <div class="nc-event" id="nc-event">{card.evento}</div>}
    <div class="nc-brand"><img src="/images/poster/organizers/cascarillatech-logo.png" alt="Cascarilla Tech" /></div>

    <div class="nc-main">
        <div class="nc-text">
            <span class="nc-kicker" id="nc-kicker">{card.etiqueta}</span>
            <div class="nc-scenes">
                {card.escenas.map((scene, i) => (
                    <div class={`nc-scene${chars(scene.titular).length > 24 ? ' nc-scene--long' : ''}`} data-scene={i}>
                        <h1 class="nc-title">
                            {chars(scene.titular).map((ch) => <span class="tw-char">{ch}</span>)}
                        </h1>
                        <div class="nc-rule"></div>
                        {scene.liña && (
                            <p class="nc-line">
                                {chars(scene.liña).map((ch) => <span class="tw-char">{ch}</span>)}
                            </p>
                        )}
                        {scene.detalle && (
                            <p class="nc-detail">
                                {chars(scene.detalle).map((ch) => <span class="tw-char">{ch}</span>)}
                            </p>
                        )}
                    </div>
                ))}
            </div>
        </div>

        {card.imaxe && (
            <div class={`nc-hero ${heroClass}`} id="nc-hero">
                {card.tipo === 'ponente'
                    ? <div class="nc-hex"><img src={card.imaxe} alt={card.titular} /></div>
                    : <img src={card.imaxe} alt="" />}
            </div>
        )}
    </div>

    {sponsors.length > 0 && (
        <div class="nc-sponsors" id="nc-sponsors">
            <span class="nc-sponsors-label">Powered by</span>
            <div class="nc-sponsors-logos">
                {sponsors.map((f) => <img src={`/images/poster/sponsors/${f}`} alt="" />)}
            </div>
        </div>
    )}

    {card.pe && (
        <div class="nc-footer"><span id="nc-pe">
            {chars(card.pe).map((ch) => <span class="tw-char">{ch}</span>)}
        </span></div>
    )}
</div>

<script>
    import { gsap } from 'gsap';

    // Constantes: espello de src/lib/newsCard.ts / posterTiming.ts.
    const CHAR_STAGGER = 0.033;
    const CHAR_TAIL = 0.13;
    const INTRO = 0.75;
    const RULE_DURATION = 0.46;
    const SCENE_HOLD = 1.1;
    const SCENE_FADE = 0.35;

    function addType(tl: any, el: Element | null, start: number) {
        if (!el) return start;
        const chars = el.querySelectorAll('.tw-char');
        if (!chars.length) return start;
        tl.to(chars, { opacity: 1, duration: 0.01, stagger: CHAR_STAGGER }, start);
        return start + (chars.length - 1) * CHAR_STAGGER + 0.01 + CHAR_TAIL;
    }

    function boot() {
        const root = document.getElementById('poster')!;
        const compId = root.getAttribute('data-composition-id')!;
        const tl = gsap.timeline({ paused: true });

        tl.to('#nc-kicker', { opacity: 1, y: 0, duration: 0.4 }, 0);
        if (document.getElementById('nc-event')) tl.to('#nc-event', { opacity: 1, y: 0, duration: 0.4 }, 0);
        const hero = document.getElementById('nc-hero');
        if (hero) tl.to(hero, { opacity: 1, scale: 1, duration: 0.6 }, 0.15);
        const sponsors = document.getElementById('nc-sponsors');
        if (sponsors) tl.to(sponsors, { opacity: 1, duration: 0.5 }, 0.3);

        let t = INTRO;
        const scenes = Array.from(document.querySelectorAll('.nc-scene'));
        scenes.forEach((scene, i) => {
            t = addType(tl, scene.querySelector('.nc-title'), t);
            tl.to(scene.querySelector('.nc-rule'), { scaleX: 1, duration: RULE_DURATION, ease: 'power2.inOut' }, t);
            t += RULE_DURATION;
            t = addType(tl, scene.querySelector('.nc-line'), t);
            t = addType(tl, scene.querySelector('.nc-detail'), t);
            if (i < scenes.length - 1) {
                // Pausa e saída da pantalla; a seguinte escríbese xusto despois.
                tl.to(scene, { opacity: 0, y: -14, duration: SCENE_FADE, ease: 'power1.in' }, t + SCENE_HOLD);
                t += SCENE_HOLD + SCENE_FADE;
            }
        });
        addType(tl, document.getElementById('nc-pe'), t);

        // Rexistrar SÓ despois de construír o timeline (ver os carteis de evento).
        (window as any).__timelines = (window as any).__timelines || {};
        (window as any).__timelines[compId] = tl;
        (window as any).__hfForceTimelineRebind?.();
        if (!(window as any).__hf) tl.play();
    }

    if ((document as any).fonts && (document as any).fonts.ready) (document as any).fonts.ready.then(boot);
    else window.addEventListener('load', boot);
</script>
</body>
</html>

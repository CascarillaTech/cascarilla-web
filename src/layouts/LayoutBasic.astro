---
import '../styles/main.css';

import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';

import logo from '../assets/cascarillatech.svg';

const { title, noindex } = Astro.props.frontmatter || Astro.props;

const org = await getEntry('org', 'info');
const cif = org?.data.cif;
---

<!DOCTYPE html>
<html lang="gl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
</head>
<body>

<header class="header">
    <nav class="nav-container">
        <a href="/" class="nav-logo-link">
            <Image src={logo} alt="Logo de Cascarilla Tech" class="nav-logo" />
        </a>

        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-menu">
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
        </button>

        <ul class="nav-menu" id="nav-menu">
            <li><a href="/about">Quen somos</a></li>
            <li><a href="/news">Novas</a></li>
            <li><a href="/events">Eventos</a></li>
            <li><a href="/communities">As nosas amigas</a></li>
            <li><a href="/partners">Colaboradoras</a></li>
            <li><a href="/membership" class="nav-cta">Faite socio/a</a></li>
        </ul>
    </nav>
    <slot name="header-extra" />
</header>

<main>

    <slot />
</main>

<script>
    const navToggle = document.getElementById('nav-toggle');
    const navMenu = document.getElementById('nav-menu');

    const setOpen = (open) => {
        navMenu?.classList.toggle('open', open);
        navToggle?.classList.toggle('open', open);
        navToggle?.setAttribute('aria-expanded', String(open));
    };

    navToggle?.addEventListener('click', () => {
        setOpen(!navMenu?.classList.contains('open'));
    });

    navMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
    });
</script>


<footer class="footer">
    <slot name="footer-extra" />
    <p>&copy; 2026 Asociación Cascarilla Tech. CIF {cif}</p>
    <p>A Coruña, Galicia</p>
    <p class="footer-legal-links">
        <a href="/legal">Aviso legal</a> · <a href="/privacy">Política de privacidade</a>
    </p>
</footer>
</body>
</html>